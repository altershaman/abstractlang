{
  "name": "abstractlang-development",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "service",
    "cli",
    "lsp"
  ],
  "scripts": {
    "test": "node --test core/test/*.test.js service/test/*.test.js cli/test/*.test.js lsp/test/*.test.js",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext core/test/types.ts --types node"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/altershaman/abstractlang.git"
  }
}
