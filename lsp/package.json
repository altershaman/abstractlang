    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": "./bin/abstract-lsp.js"
  },
  "bin": {
    "abstract-lsp": "./bin/abstract-lsp.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@abstractlang/core": "1.0.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16",
    "@abstractlang/service": "1.0.0"
  },
  "types": "./src/index.d.ts",
  "peerDependencies": {
    "@types/node": ">=20"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
