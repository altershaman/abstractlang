{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    }
  ],
  "wordPattern": "[^\\s.:!()@/\\[\\]{}'\\\";,]+",
  "indentationRules": {
    "increaseIndentPattern": "(?:::|\\.)\\s*(?://.*)?$"
  }
}
